#!/usr/bin/env python3

import argparse
import json
import os
from datetime import datetime, timedelta

OCCUPATION_FILE = "/tmp/occupation.json"
LOG_FILE = "/home/pi/.checkin.log"
MAX_LOG_SIZE = 1024 * 1024  # 1 MB

class OccupationManager:
    def __init__(self):
        self.occupation_file = OCCUPATION_FILE
        self.log_file = LOG_FILE
        self.max_log_size = MAX_LOG_SIZE

    def load_occupation(self):
        if os.path.exists(self.occupation_file):
            with open(self.occupation_file, "r") as f:
                return json.load(f)
        return None

    def save_occupation(self, occupation):
        with open(self.occupation_file, "w") as f:
            json.dump(occupation, f)

    def log_action(self, action, user, message=""):
        timestamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
        log_entry = f"{timestamp} - {action}: {user} {message}\n"

        if os.path.exists(self.log_file) and os.path.getsize(self.log_file) > self.max_log_size:
            with open(self.log_file, "r") as f:
                lines = f.readlines()
            with open(self.log_file, "w") as f:
                f.writelines(lines[len(lines)//2:])

        with open(self.log_file, "a") as f:
            f.write(log_entry)

    def parse_duration(self, duration):
        try:
            hours, minutes = map(int, duration.split(':'))
            # Handle minute overflow
            if minutes >= 60:
                extra_hours = minutes // 60
                minutes = minutes % 60
                hours += extra_hours
            return hours, minutes
        except ValueError:
            raise ValueError("Invalid duration format. Please use Hours(digits):Minutes(digits).")

    def check_in(self, user, duration, task):
        try:
            hours, minutes = self.parse_duration(duration)
        except ValueError as e:
            print(e)
            return

        occupation = self.load_occupation()
        current_time = datetime.now()
        expiration_time = current_time + timedelta(hours=hours, minutes=minutes)

        if occupation and current_time < datetime.fromisoformat(occupation["expiration_time"]):
            self.log_action("Force Check-in", user, f"Overriding {occupation['user']}")
        else:
            self.log_action("Check-in", user)

        occupation = {
            "user": user,
            "expiration_time": expiration_time.isoformat(),
            "task": task
        }
        self.save_occupation(occupation)
        print(f"Check-in successful for {user}")

    def print_status(self):
        occupation = self.load_occupation()
        if occupation:
            current_time = datetime.now()
            expiration_time = datetime.fromisoformat(occupation["expiration_time"])
            if current_time < expiration_time:
                remaining_time = expiration_time - current_time
                total_seconds = remaining_time.total_seconds()
                hours = total_seconds // 3600
                minutes = (total_seconds % 3600) // 60
                print(f"Current occupation:")
                print(f"User: {occupation['user']}")
                print(f"Remaining time: {int(hours):02d}:{int(minutes):02d}")
                print(f"Task Description: {occupation['task']}")
            else:
                print("No current occupation")
                os.remove(self.occupation_file)
        else:
            print("No current occupation")

    def cancel_occupation(self):
        if os.path.exists(self.occupation_file):
            occupation = self.load_occupation()
            self.log_action("Cancel", occupation["user"])
            os.remove(self.occupation_file)
            print("Occupation cancelled")
        else:
            print("No current occupation to cancel")

    def check_expiration(self):
        occupation = self.load_occupation()
        if occupation:
            current_time = datetime.now()
            expiration_time = datetime.fromisoformat(occupation["expiration_time"])
            if current_time >= expiration_time:
                self.log_action("Expiration", occupation["user"])
                os.remove(self.occupation_file)

    def show_current_occupation(self):
        self.check_expiration()
        self.print_status()

def main():
    parser = argparse.ArgumentParser(description="Check-in System")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("-occupy", "-o", action="store_true", help="Claim to occupy the system")
    group.add_argument("-cancel", "-c", action="store_true", help="Cancel current occupation")
    group.add_argument("-print", "-p", action="store_true", help="Print current occupation status")

    args = parser.parse_args()
    manager = OccupationManager()

    if args.occupy:
        user = input("Enter your name: ")
        duration = input("Enter occupation duration (HH:MM): ")
        task = input("Enter task description: ")
        manager.check_in(user, duration, task)
    elif args.cancel:
        manager.cancel_occupation()
    elif args.print:
        manager.show_current_occupation()

if __name__ == "__main__":
    main()
